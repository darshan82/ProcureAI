# Copy to .env and fill in. .env is git-ignored: your keys never leave your machine.
#   cp .env.example .env

# ---- OpenAI (optional) ----
# Leave empty to run fully offline with the built-in mock LLM + hash embeddings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# ---- LangSmith tracing (optional) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=procurement-ai-platform
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
DEMO_PASSWORD=demo123

# ---- Semantic cache ----
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=3600

# ---- Local S3 (LocalStack) ----
S3_BUCKET=procurement-documents

# ---- Ports on your machine ----
WEB_PORT=8080
API_PORT=4000
