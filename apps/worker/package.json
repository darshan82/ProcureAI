{
  "name": "procurement-ingestion-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kafka consumer: streams documents from S3, parses PDF, chunks, batch-embeds and upserts into MongoDB",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@langchain/core": "^1.3.4",
    "@langchain/openai": "^1.8.0",
    "@langchain/textsplitters": "^1.0.2",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.8.0",
    "pdf-parse": "^2.4.5",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
